<Window x:Class="WaterCoolerApp.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aqua Core — Hardware Studio" Height="900" Width="1480" MinHeight="760" MinWidth="1120" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
 Loaded="Window_Loaded" Closed="Window_Closed">
 <Window.Resources>
  <Storyboard x:Key="IntroStoryboard">
   <DoubleAnimation Storyboard.TargetName="MainContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.65"/>
   <DoubleAnimation Storyboard.TargetName="IntroTransform" Storyboard.TargetProperty="Y" From="18" To="0" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
   <DoubleAnimation Storyboard.TargetName="RingRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:18" RepeatBehavior="Forever"/>
   <DoubleAnimation Storyboard.TargetName="AmbientGlow" Storyboard.TargetProperty="Opacity" From="0.22" To="0.52" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever"/>
  </Storyboard>
  <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
   <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0"/>
   <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
   <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#4162E6C5" BlurRadius="22" ShadowDepth="0" Opacity="0.42"/></Setter.Value></Setter></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
   <Grid Margin="16,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="22" Height="22" CornerRadius="6" Background="#183C4A"><TextBlock Text="A" Foreground="#70E8D0" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="AQUA CORE" FontSize="11" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Width="38" Height="30" Click="MinimizeWindow_Click" ToolTip="Minimize" Background="Transparent" BorderThickness="0" Padding="7"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M5,12 L19,12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button><Button Width="38" Height="30" Click="MaximizeWindow_Click" ToolTip="Maximize / Restore" Background="Transparent" BorderThickness="0" Padding="7"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M5,3 L19,3 Q21,3 21,5 L21,19 Q21,21 19,21 L5,21 Q3,21 3,19 L3,5 Q3,3 5,3 Z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"/></Canvas></Viewbox></Button><Button Width="38" Height="30" Click="CloseWindow_Click" ToolTip="Close" Background="Transparent" BorderThickness="0" Padding="7"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button></StackPanel></Grid>
  </Border>
  <Grid Grid.Row="1" Margin="20,12,20,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="22" Padding="16">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Margin="5,4,0,30">
       <Border Width="42" Height="42" CornerRadius="14" Background="#183C4A" BorderBrush="#3A7F82" BorderThickness="1"><Grid><Path Data="M 21,7 C 17,14 11,18 13,25 C 15,32 27,32 29,25 C 31,18 25,13 21,7 Z" Fill="#70E8D0"/><Ellipse Width="5" Height="5" Fill="#E7FFF9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,9,0"/></Grid></Border>
       <StackPanel VerticalAlignment="Center" Margin="11,0,0,0"><TextBlock Text="AQUA CORE" FontSize="15" FontWeight="Bold"/><TextBlock Text="HARDWARE STUDIO" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel>
      </StackPanel>
      <TextBlock Text="WORKSPACE" Style="{StaticResource SmallLabel}" Margin="8,0,0,10"/>
      <Button x:Name="NavOverviewButton" Click="NavOverview_Click" Style="{StaticResource NavButton}" Background="{DynamicResource PanelRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" FontSize="17" Width="29" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Overview" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
      <Button x:Name="NavCoolingButton" Click="NavCooling_Click" Style="{StaticResource NavButton}" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="17" Width="29"/><TextBlock Text="Cooling" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="NavHardwareButton" Click="NavHardware_Click" Style="{StaticResource NavButton}" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="17" Width="29"/><TextBlock Text="Hardware" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="NavSettingsButton" Click="NavSettings_Click" Style="{StaticResource NavButton}" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="29"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
      <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="4,22,4,20"/>
      <TextBlock Text="DISPLAY DEVICE" Style="{StaticResource SmallLabel}" Margin="8,0,0,12"/>
      <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="11">
       <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Waiting for device" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock Text="USB / HID connection not enabled" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
      </Border>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
      <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="14" Padding="12"><StackPanel><TextBlock Text="SYSTEM SETTINGS" Style="{StaticResource SmallLabel}"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><TextBlock Text="Interface theme" FontSize="11" VerticalAlignment="Center"/><ComboBox x:Name="ThemeSelector" Grid.Column="1" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged" Height="29" FontSize="11"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><TextBlock Text="Refresh rate" FontSize="11" VerticalAlignment="Center"/><ComboBox x:Name="PollIntervalSelector" Grid.Column="1" SelectedIndex="1" SelectionChanged="PollIntervalSelector_SelectionChanged" Height="29" FontSize="11"><ComboBoxItem Content="1 sec"/><ComboBoxItem Content="2 sec"/><ComboBoxItem Content="5 sec"/></ComboBox></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><TextBlock Text="Language" FontSize="11" VerticalAlignment="Center"/><ComboBox x:Name="LanguageSelector" Grid.Column="1" SelectedIndex="1" SelectionChanged="LanguageSelector_SelectionChanged" Height="29" FontSize="11"><ComboBoxItem Content="English"/><ComboBoxItem Content="Português"/></ComboBox></Grid></StackPanel></Border>
      <StackPanel Orientation="Horizontal" Margin="6,16,0,2"><Border Width="27" Height="27" CornerRadius="9" Background="#203B45"><TextBlock Text="AC" Foreground="#70E8D0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Aqua Core" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Preview build · .NET 10" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
     </StackPanel>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Column="2" x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="MainContent" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform x:Name="IntroTransform" Y="18"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" MouseLeftButtonDown="Header_MouseLeftButtonDown"><TextBlock Text="System overview" FontSize="29" FontWeight="Bold"/><TextBlock Text="Your hardware, at a glance." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel></Grid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="CpuTempText" Text="--°" FontSize="31" FontWeight="Bold" Margin="0,12,0,1"/><TextBlock x:Name="CpuLoadText" Text="Utilization --%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Width="35" Height="35" CornerRadius="11" Background="#1C3D3B" VerticalAlignment="Top"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M5,6 C5,5.45 5.45,5 6,5 L18,5 C18.55,5 19,5.45 19,6 L19,18 C19,18.55 18.55,19 18,19 L6,19 C5.45,19 5,18.55 5,18 Z M9,9 L15,9 L15,15 L9,15 Z M3,10 L5,10 M3,14 L5,14 M10,3 L10,5 M14,3 L14,5 M19,10 L21,10 M19,14 L21,14 M10,19 L10,21 M14,19 L14,21" Stroke="#70E8D0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Border></Grid></Border>
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GPU" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="GpuTempText" Text="--°" FontSize="31" FontWeight="Bold" Margin="0,12,0,1"/><TextBlock x:Name="GpuLoadText" Text="Utilization --%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Border Grid.Column="1" Width="35" Height="35" CornerRadius="11" Background="#1B3047" VerticalAlignment="Top"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M3,4 L3,18 M3,6 L20,6 Q21,6 21,7 L21,15 Q21,16 20,16 L3,16 M9,13 A2,2 0 1 0 9,9 A2,2 0 1 0 9,13 M15,9 L15,13 M18,9 L18,13 M7,16 L7,19 L15,19 L15,16" Stroke="#69BFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Border></Grid></Border>
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="MemoryText" Text="--%" FontSize="29" FontWeight="Bold" Margin="0,12,0,1"/><TextBlock x:Name="MemoryPercentText" Text="-- GB / -- GB Total - -- GB free" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,7"/><ProgressBar x:Name="MemoryUsageBar" Height="5" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PanelRaisedBrush}" BorderThickness="0"/></StackPanel><Border Grid.Column="1" Width="35" Height="35" CornerRadius="11" Background="#302947" VerticalAlignment="Top"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M12,11 L12,13 M16,11 L16,13 M3,7 L21,7 Q22,7 22,8 L22,9 Q22,10 21,10 Q20,10 20,11 L20,13 Q20,14 21,14 Q22,14 22,15 L22,17 Q22,18 21,18 L3,18 Q2,18 2,17 L2,15 Q2,14 3,14 Q4,14 4,13 L4,11 Q4,10 3,10 Q2,10 2,9 L2,8 Q2,7 3,7 Z M8,11 L8,13 M4,18 L4,20 M7,18 L7,20 M10,18 L10,20 M13,18 L13,20 M17,18 L17,20 M20,18 L20,20" Stroke="#BDA3FF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Border></Grid></Border>
     <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="STORAGE" Style="{StaticResource SmallLabel}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,1"><TextBlock x:Name="StorageDriveNameText" Text="C:" FontSize="29" FontWeight="Bold" Margin="0,0,7,0"/><TextBlock x:Name="StorageUsedPercentText" Text="--%" FontSize="29" FontWeight="Bold"/></StackPanel><TextBlock x:Name="StorageCapacityText" Text="Waiting for disk data" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,7"/><ProgressBar x:Name="StorageUsageBar" Height="5" Maximum="100" Value="0" Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource PanelRaisedBrush}" BorderThickness="0"/></StackPanel><Border Grid.Column="1" Width="35" Height="35" CornerRadius="11" Background="#3A2C20" VerticalAlignment="Top"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M10,16 L10.01,16 M2.212,11.577 A2,2 0 0 0 2,12.473 L2,18 A2,2 0 0 0 4,20 L20,20 A2,2 0 0 0 22,18 L22,12.473 A2,2 0 0 0 21.788,11.577 L18.55,5.11 A2,2 0 0 0 16.76,4 L7.24,4 A2,2 0 0 0 5.45,5.11 Z M21.946,12.013 L2.054,12.013 M6,16 L6.01,16" Stroke="#F4BD68" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox></Border></Grid></Border>
    </UniformGrid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
     <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="1.15*"/><RowDefinition Height="16"/><RowDefinition Height="0.85*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Thermal performance" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Live temperature history · rolling 30 minutes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="CPU" FontSize="10" Margin="0,0,13,0"/><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBlueBrush}" Margin="0,0,7,0"/><TextBlock Text="GPU" FontSize="10"/></StackPanel></Grid>
       <Grid Grid.Row="1" Margin="0,15,0,10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="90°" Grid.Row="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Top"/><TextBlock Text="70°" Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="50°" Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="30°" Grid.Row="3" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Bottom"/>
        <Viewbox Grid.Column="1" Grid.RowSpan="4" Stretch="Fill" ClipToBounds="True"><Canvas x:Name="ThermalChartCanvas" Width="900" Height="136" ClipToBounds="True"><Line X1="0" Y1="8" X2="900" Y2="8" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Line X1="0" Y1="48" X2="900" Y2="48" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Line X1="0" Y1="88" X2="900" Y2="88" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Line X1="0" Y1="128" X2="900" Y2="128" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Path x:Name="CpuHistoryPath" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" Fill="{x:Null}"/><Path x:Name="GpuHistoryPath" Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="{x:Null}" Opacity="0.9"/></Canvas></Viewbox>
       </Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Rolling 30 minutes · data since launch" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="GraphCaption" Grid.Column="1" Text="Waiting for sensor data" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid></Grid></Border>
      <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Utilization performance" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Live CPU, GPU and memory history · rolling 30 minutes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/><TextBlock Text="CPU" FontSize="10" Margin="0,0,10,0"/><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBlueBrush}" Margin="0,0,6,0"/><TextBlock Text="GPU" FontSize="10" Margin="0,0,10,0"/><Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" Margin="0,0,6,0"/><TextBlock Text="RAM" FontSize="10"/></StackPanel></Grid><Grid Grid.Row="1" Margin="0,15,0,10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="100%" Grid.Row="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Top"/><TextBlock Text="75%" Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="50%" Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="25%" Grid.Row="3" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Bottom"/><Viewbox Grid.Column="1" Grid.RowSpan="4" Stretch="Fill" ClipToBounds="True"><Canvas Width="900" Height="136" ClipToBounds="True"><Line X1="0" Y1="8" X2="900" Y2="8" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Line X1="0" Y1="38" X2="900" Y2="38" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Line X1="0" Y1="68" X2="900" Y2="68" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Line X1="0" Y1="98" X2="900" Y2="98" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Line X1="0" Y1="128" X2="900" Y2="128" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" StrokeDashArray="3 5"/><Path x:Name="CpuUtilizationHistoryPath" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" Fill="{x:Null}"/><Path x:Name="GpuUtilizationHistoryPath" Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="{x:Null}"/><Path x:Name="MemoryUtilizationHistoryPath" Stroke="{DynamicResource WarningBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Rolling 30 minutes · data since launch" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="UtilizationGraphCaption" Grid.Column="1" Text="Waiting for sensor data" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid></Grid></Border>
     </Grid>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="16"/><RowDefinition Height="0.9*"/></Grid.RowDefinitions>
      <Border x:Name="CoolerCard" Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True"><Grid><Ellipse x:Name="AmbientGlow" Width="205" Height="205" Fill="#1E4ED8B5" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect></Ellipse><StackPanel VerticalAlignment="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Water cooler" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Pump display preview" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="8,5"><TextBlock Text="CPU ONLY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></Border></Grid></StackPanel>
       <Grid Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"><Ellipse Width="192" Height="192" Fill="#101923" Stroke="#2C4651" StrokeThickness="1.5"/><Ellipse Width="168" Height="168" Stroke="#20333F" StrokeThickness="12"/><Ellipse Width="168" Height="168" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeDashArray="1 2" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform x:Name="RingRotation" Angle="0"/></Ellipse.RenderTransform><Ellipse.Effect><DropShadowEffect Color="#6262E6C5" BlurRadius="17" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect></Ellipse><Ellipse Width="139" Height="139" Fill="#111C27" Stroke="#30414F" StrokeThickness="1"/><StackPanel VerticalAlignment="Center"><Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"><Canvas Width="24" Height="24"><Path Data="M12,3 C10.9,3 10,3.9 10,5 L10,14.2 A4,4 0 1 0 14,14.2 L14,5 C14,3.9 13.1,3 12,3 Z M12,8 L12,17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock x:Name="CoolerDisplayTemp" Text="--" FontFamily="Consolas" FontSize="49" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"/><TextBlock Text="Temp/ºC" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Grid>
       <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,0"><Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="10" Padding="10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0"/><TextBlock x:Name="DeviceStatusText" Text="Hardware link not connected" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border><TextBlock Text="Preview only · HID transmission disabled" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
      </Grid></Border>
